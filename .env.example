# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Database (omit DB_ENGINE to use a local SQLite dev DB)
# Managed PostgreSQL — see docs/decisions/0001-managed-postgresql.md
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=transport
# DB_USER=postgres
# DB_PASSWORD=change-me
# Supabase: use the session pooler, port 5432. The direct host
# db.<ref>.supabase.co is IPv6-only in several regions.
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10