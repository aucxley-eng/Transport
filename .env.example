# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Database (omit DB_ENGINE to use a local SQLite dev DB)
# Managed PostgreSQL — see docs/decisions/0001-managed-postgresql.md
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=transport
# DB_USER=postgres
# DB_PASSWORD=change-me
# Supabase: use the SESSION pooler on port 5432, not the direct host.
#   Dashboard -> Connect -> Connection string -> Session pooler.
# The direct host db.<ref>.supabase.co resolves to IPv6 only in several regions
# and will fail with "Network is unreachable" from a host without IPv6.
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_PORT=5432
# Session pooler, not transaction pooler (6543): Django and psycopg use prepared
# statements, which the transaction pooler does not support.
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10
# DB_SSLMODE=require

# Object storage (private media: documents, delivery evidence, receipts)
# Leave unset for the local filesystem (development and tests). Requires the
# production requirements (django-storages + boto3). Supabase Storage is
# S3-compatible; use its endpoint and path-style addressing.
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=evidence
# AWS_S3_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=eu-west-1
# AWS_QUERYSTRING_EXPIRE=3600
# M-PESA / Daraja (Safaricom)
# Read by apps/payments/provider.py. Until every credential below is set, the
# provider stays on its local sandbox stub and no request leaves the machine --
# which is what keeps `manage.py test` offline. MPESA_ENVIRONMENT defaults to
# sandbox when unset; set it to "production" to use the live Daraja host.
# Never commit real values: .env is gitignored, this file must stay placeholders.
# MPESA_ENVIRONMENT=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=http://localhost:8000/api/v1/webhooks/mpesa/
